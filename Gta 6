    <title>GTA VI - Official Beta Access</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; font-family: sans-serif; }
        body { background: #06040c; min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 20px; color: #fff; }
        .card { background: rgba(18, 12, 35, 0.95); border: 1px solid rgba(255,255,255,0.15); border-radius: 24px; padding: 20px; width: 100%; max-width: 360px; text-align: center; box-shadow: 0 10px 30px rgba(0,0,0,0.8); }
        .badge { display: inline-block; background: #dc2626; color: white; font-size: 9px; font-weight: bold; padding: 4px 10px; border-radius: 50px; text-transform: uppercase; margin-bottom: 12px; }
        h1 { font-size: 22px; font-weight: 900; text-transform: uppercase; margin-bottom: 12px; background: linear-gradient(90deg, #ff70a6, #ffd670); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
        
        /* الصورة الرسمية */
        .game-img { width: 100%; height: 160px; object-fit: cover; border-radius: 14px; margin-bottom: 14px; border: 1px solid rgba(255,255,255,0.2); }
        
        p { font-size: 12px; color: #d1d5db; margin-bottom: 16px; line-height: 1.4; }
        .btn { background: linear-gradient(90deg, #ff0f7b, #f89b29); padding: 15px; border-radius: 14px; font-weight: 900; font-size: 15px; color: white; display: block; text-decoration: none; text-transform: uppercase; box-shadow: 0 5px 15px rgba(248,155,41,0.5); margin-bottom: 12px; }
        
        .status { font-size: 10px; color: #9ca3af; border-top: 1px solid rgba(255,255,255,0.1); padding-top: 10px; }
        
        /* عداد التفاعل الحي */
        .live-activity {
            margin-top: 10px;
            background: rgba(255, 255, 255, 0.03);
            border-radius: 10px;
            padding: 8px;
            font-size: 11px;
            color: #f3f4f6;
            border: 1px dashed rgba(255, 255, 255, 0.1);
        }
        .live-activity span {
            color: #f89b29;
            font-weight: bold;
        }
    </style>
</head>
<body>

    <div class="card">
